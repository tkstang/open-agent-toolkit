{
  "name": "oat-docs",
  "version": "0.1.0",
  "description": "Documentation for Open Agent Toolkit",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "predev": "fumadocs-mdx && pnpm exec oat docs generate-index",
    "dev": "next dev",
    "prebuild": "fumadocs-mdx && pnpm exec oat docs generate-index",
    "build": "next build",
    "start": "next start",
    "docs:lint": "markdownlint-cli2 'docs/**/*.md'",
    "docs:format": "prettier --write 'docs/**/*.md'",
    "docs:format:check": "prettier --check 'docs/**/*.md'"
  },
  "dependencies": {
    "@oat/docs-config": "workspace:*",
    "@oat/docs-theme": "workspace:*",
    "@oat/docs-transforms": "workspace:*",
    "fumadocs-core": "^16.6.13",
    "fumadocs-mdx": "^14.2.9",
    "fumadocs-ui": "^16.6.13",
    "next": "^16.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@oat/cli": "workspace:*",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "markdownlint-cli2": "^0.13.0",
    "prettier": "^3.4.2"
  }
}
